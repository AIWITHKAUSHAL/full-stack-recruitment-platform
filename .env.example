# =============================================================================
# Mini Job Board Application Tracker — example environment file
# Copy to .env for local development:  cp .env.example .env
# NEVER commit the real .env — it is in .gitignore.
# =============================================================================

# ---------- runtime ----------
ENVIRONMENT=local                 # local | dev | prod  (non-local refuses insecure defaults)
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# ---------- database ----------
# Local docker compose value. On AWS this is injected by the ECS task definition
# from the Terraform-generated secret — it is never baked into an image.
POSTGRES_USER=jobboard
POSTGRES_PASSWORD=jobboard_local_password
POSTGRES_DB=jobboard
DATABASE_URL=postgresql+psycopg://jobboard:jobboard_local_password@postgres:5432/jobboard

# ---------- admin authentication ----------
# Generate a real one with:  openssl rand -hex 32
JWT_SECRET_KEY=change-me-in-every-environment-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Bootstrap admin, created by `make seed` / scripts/seed.sh. Change the password.
ADMIN_EMAIL=admin@minijobboard.dev
ADMIN_PASSWORD=ChangeMe123!

# ---------- CORS ----------
# Comma separated. In production this is the CloudFront URL only.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- resume storage (S3) ----------
# Leave S3_RESUME_BUCKET empty locally: the storage service then writes to
# backend/.local-storage/ so the app still works without AWS credentials.
S3_RESUME_BUCKET=
AWS_REGION=us-east-1
RESUME_MAX_BYTES=5242880
RESUME_PRESIGN_EXPIRY_SECONDS=300

# ---------- frontend (vite) ----------
# Local dev proxies /api to the backend, so the default relative base works.
VITE_API_BASE_URL=http://localhost:8000/api/v1
